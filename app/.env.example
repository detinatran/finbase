# ---------- Chain ----------
# Local demo (anvil):      CHAIN_ID=31337  RPC_URL=http://127.0.0.1:8545
# Base Sepolia (evidence): CHAIN_ID=84532  RPC_URL=https://sepolia.base.org  EXPLORER_URL=https://sepolia.basescan.org
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
EXPLORER_URL=

# Agent hot key (PolicyWallet "operator"). Default = anvil account #1.
OPERATOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# DEMO ONLY: owner key held server-side so the "Approve" button works without a browser wallet.
# In production the owner signs in their own wallet. Default = anvil account #0.
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---------- LLM ----------
# scripted  = offline deterministic agent (no API key, great for rehearsing the demo)
# anthropic = Claude via the official Anthropic SDK
# openai    = any OpenAI-compatible endpoint (Gemini free tier, Ollama, OpenAI, ...)
LLM_PROVIDER=scripted

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama:  http://127.0.0.1:11434/v1
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# ---------- Red-team ----------
# Enables the "bypass Layer 2" button that sends raw transactions straight to the
# contract to prove Layer 3 holds on its own. Turn off for anything but demos.
ALLOW_REDTEAM_BYPASS=true
